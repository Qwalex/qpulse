# Base URL without /api/v1 suffix (app adds it automatically)
EXPO_PUBLIC_API_URL=http://localhost:3001

# Optional dedicated WebSocket base URL (without path)
# EXPO_PUBLIC_WS_URL=ws://localhost:3001

# Android emulator example:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
# EXPO_PUBLIC_WS_URL=ws://10.0.2.2:3001

# Production (Railway):
EXPO_PUBLIC_API_URL=https://qpulse-api-production.up.railway.app
EXPO_PUBLIC_WS_URL=https://qpulse-api-production.up.railway.app
